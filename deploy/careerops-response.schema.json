{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "messages"],
  "properties": {
    "summary": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "thread_ts", "files"],
        "properties": {
          "text": {
            "type": "string"
          },
          "thread_ts": {
            "type": ["string", "null"]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "title"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
